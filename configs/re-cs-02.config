# Baseline .config fragment for JDCloud RE-CS-02 (Athena, IPQ6018, 512 MB).
#
# This is a FRAGMENT, not a full .config. The workflow copies it to .config
# and runs `make defconfig`, which expands it against the LiBwrt tree
# (LiBwrt/LibWrt, branch 25.12-nss, kernel 6.12, pinned commit
# 96a0ec8a427909c4d9ef112641b36bcc0728fa43).
# The workflow greps the expanded .config after defconfig and fails the
# build if a required symbol was dropped, so a wrong symbol name fails
# loudly instead of silently producing a non-NSS image.
#
# Device: JDCloud RE-CS-02 (Athena), IPQ6018 (ipq6010 SoC) + QCN9074
# 5 GHz radio, 512 MB RAM, eMMC. UNTESTED: the user has no Athena
# hardware; this config is built but its image is unverified on device.
# The NSS stack comes from the base tree's qualcommax
# DEFAULT_PACKAGES (qca-nss-dp, nss-ifb, qca-nss-drv, qca-nss-ecm and all
# managers) and from defaults (ATH11K_NSS_SUPPORT default y,
# ATH11K_MEM_PROFILE_512M default, NSS_MEM_PROFILE default MEDIUM for
# 512 MB) — this fragment keeps only the lines that are NOT already a
# default. What was deliberately left out, and why, is in the project
# parity table (see the scaffold report); nothing from the CR880x
# cr8806 config was dropped silently.

# Target: qualcommax/ipq60xx, device profile jdcloud_re-cs-02
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# --- Athena LED (RE-CS-02 only; fetched by scripts/diy.sh) ---
# The LED screen control app + its Chinese translation. Installed only
# on RE-CS-02 (per-device config, not DEVICE_PACKAGES — this config
# builds one device only, like the CR880x per-device configs).
CONFIG_PACKAGE_luci-app-athena-led=y

# --- NSS firmware line (must be explicit: the menu default is 11.4) ---
# 12.5 Release 210 is the default for this project. The driver is built
# for exactly one firmware version; never enable two. 12.5 does NOT work
# with NSS MESH (802.11s) — only 11.4 does (nss-firmware Makefile).
# The workflow swaps this pair to 12.2 when the firmware input is 12.2.
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_NSS_FIRMWARE_VERSION_12_2 is not set
# nss-firmware-ipq60xx is a target default (ipq60xx/target.mk) — not set here.
# NSS_MEM_PROFILE: default MEDIUM for ipq60xx (512 MB) — not set here
# (the CR880x LOW profile is for 256 MB boards only).
# NSS_DRV_VLAN_ENABLE / IPV6_ENABLE / VIRT_IF_ENABLE / WIFIOFFLOAD_ENABLE:
# all default n, but all auto-selected (ECM selects IPV6 + VIRT_IF;
# vlan-mgr selects VLAN; ATH11K_NSS_SUPPORT selects WIFIOFFLOAD) — not
# set here. The defconfig guard checks the expanded .config for all of
# them being y.

# --- Wi-Fi driver gates (LOAD-BEARING, same lesson as the CR880x project) ---
# ath11k requires @DRIVER_11AC_SUPPORT + @DRIVER_11AX_SUPPORT. Both are
# bool default n in hostapd/Config.in and nothing selects them, so they
# must be set explicitly here; without them defconfig drops
# kmod-ath11k-ahb (and with it the whole mac80211 stack) even though it
# is a target default.
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
# kmod-ath11k / -ahb / -pci are target defaults — not set here.
# ath11k-firmware-ipq6018 is a target default (ipq60xx/target.mk) — not set here.
# ATH11K_NSS_SUPPORT is default y (ath.mk:400-406) — not set here.
# MAC80211_NSS_SUPPORT is default y (mac80211 Makefile) — not set here.
# Full wpad is already the tree default (wpad-openssl). The CR880x
# project's wpad-mbedtls line is NOT copied: same full-wpad feature
# set (WNM, MESH-capable), different TLS backend. Do NOT add
# wpad-basic-mbedtls (it lacks WNM and MESH).
CONFIG_PACKAGE_iw=y
# iwinfo is not needed: LuCI uses rpcd-mod-iwinfo, not the iwinfo CLI.

# --- initramfs image (recovery via TFTP boot, CR880x parity) ---
# The fork disables this; we keep it so a bricked device can be
# recovered by TFTP-booting initramfs. First-install verification is
# still open (see README).
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- LuCI ---
CONFIG_PACKAGE_luci=y
# LuCI language: English only (user decision 2026-11-05: no Chinese in
# the firmware). There is NO CONFIG_LUCI_LANG_en symbol — English is
# LuCI's source language, not a translation, so it has no option to
# select. The LiBwrt tree defaults to zh_Hans; the way to get English
# is to DESELECT zh_Hans (and the zh-cn i18n packs follow it). This
# "is not set" line MUST be explicit: without it, make defconfig
# re-adds zh_Hans and every luci-i18n-*-zh-cn pack.
# CONFIG_LUCI_LANG_zh_Hans is not set
# default-settings-chn (the CHN variant) MUST also be deselected:
# it is pulled in by default and its DEPENDS forces LUCI_LANG_zh_Hans
# (via +@LUCI_LANG_zh_Hans) and luci-i18n-base-zh-cn. Deselecting
# only the language is not enough — the chn package re-selects it.
# CONFIG_PACKAGE_default-settings-chn is not set
# default-settings (ImmortalWrt): LuCI lang auto, dnsmasq log off,
# /usr/bin/ip symlink. Neither touches hostname or LAN IP.
# NOTE: default-settings-chn (timezone Asia/Shanghai + CN NTP + apk
# mirror) was dropped by the same decision — timezone defaults to UTC,
# set it in LuCI if wanted.
CONFIG_PACKAGE_default-settings=y

# --- ZRAM swap (CR880x parity; 512 MB board) ---
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

# --- TCP BBR congestion control (CR880x parity) ---
# The default is set at first boot by 99-custom (sysctl.conf + live
# sysctl); do NOT set CONFIG_DEFAULT_TCP_CONG here (it is dropped by
# defconfig on some trees and the fragment-survival guard would fail
# the build for a line that does not matter at runtime).
CONFIG_PACKAGE_kmod-tcp-bbr=y

# --- ccache (the workflow caches openwrt/.ccache between runs) ---
CONFIG_CCACHE=y

# --- nftables NAT (CR880x + fork parity) ---
CONFIG_PACKAGE_kmod-nft-nat=y

# --- IRQ balance (fork parity: spread NSS/WiFi IRQs over the 4 cores) ---
CONFIG_PACKAGE_irqbalance=y

# --- Argon theme (fetched by scripts/diy.sh, not in the base feeds) ---
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# --- Small tools (CR880x parity) ---
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_tcpdump-mini=y

# --- eMMC tools (fork subset, hardware-justified: RE-CS-02 boots from eMMC) ---
# fdisk/fstrim come from util-linux, tune2fs from e2fsprogs (both in the
# base tree). Of the rest of the fork's tool set, only openssh-sftp-server
# is added in the fork-only section below; cfdisk, sgdisk, nano-full,
# hdparm, smartmontools-drivedb and coremark were dropped by user decision
# 2026-11-05 (disk/benchmark tools not wanted); dmesg is left out
# (busybox provides it).
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_tune2fs=y

# --- Fork-only features (user decision 2026-11-05: "Fork 独有的加上") ---
# PassWall (multi-protocol proxy manager, sing-box core) + sing-box
# itself, and the LuCI apps / tools the fork ships that the CR880x
# build does not have. PassWall REPLACES HomeProxy (user decision
# 2026-11-06 "Passwall试试"): HomeProxy is sing-box-only and light;
# PassWall adds Xray/V2Ray/Trojan/Shadowsocks, subscriptions, load
# balancing and ACL rules. Both manage sing-box, so only one is
# installed.
# NOTE: luci-app-ttyd and openssh-sftp-server were REMOVED on the CR880x
# project by an earlier user decision; they are added here only because
# the user explicitly ordered the fork-only features for THIS project
# (his live RE-SS-01 fork firmware has them).
#
# sing-box (full variant; the DIY updates the feed package to the
# latest SagerNet release on every build — user decision 2026-11-06): the
# fork's CONFIG_SINGBOX_WITH_QUIC/ECH/TUIC/GRPC/TPROXY lines are DEAD
# here — that symbol family does not exist in this feed's sing-box
# Makefile (no Config.in; the full variant hardcodes its tags:
# with_acme/with_clash_api/with_dhcp/with_gvisor/with_quic/
# with_tailscale/with_utls/with_wireguard). QUIC is therefore in by
# default; ECH/TUIC are core sing-box features (no build tag); TPROXY
# is runtime (kmod-nft-tproxy below). gRPC is NOT in the full
# variant's tag set — it exists only in the sing-box-tiny variant
# (SING_BOX_TINY_BUILD_GRPC); if gRPC is ever needed, that is a
# variant switch, not a config line. Do NOT re-add SINGBOX_WITH_*
# lines: defconfig drops them and the fragment-survival guard would
# fail the build.
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_sing-box=y
# sing-box support: TUN device + diagnostics + TPROXY socket support +
# full ip + libcap tools (fork parity).
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_libcap-bin=y

# --- Fork-only LuCI apps (installed; configure in LuCI) ---
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-usb-printer=y


# --- Image sizes (fork parity; eMMC factory image) ---

# --- Target optimization (CR880x + fork parity) ---
# LTO eats builder memory; if a build fails on memory, turn it off first
# (the fork's own config comment says the same).
CONFIG_DEVEL=y
CONFIG_TARGET_OPTIONS=y
CONFIG_USE_LTO=y
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv8-a+crypto+crc -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53"

# --- NSS SQM hardware queue (CR880x parity + user decision 2026-11-05) ---
# nssfq_codel via sqm-scripts-nss (qosmio feed, stale 2024-05-12 — noted)
# + luci-app-sqm + kmod-ifb. SQM is OFF by default (like the CR880x
# project); enable it in LuCI or UCI if wanted. The NSS qdisc module
# and nss-ifb come from the target defaults; only the scripts + UI +
# ifb need selecting here.
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-ifb=y

# --- dnsmasq caching resolver + adblock (CR880x parity) ---
# dnsmasq-full replaces the base default dnsmasq (adblock needs its
# nftset support); same config section, same cache setting.
# ca-bundle is kept for TLS verification (opkg/LuCI https), not for DNS.
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# --- Deliberately NOT configured here (runtime defaults, not .config) ---
# Kernel flow offloading (firewall.@defaults[0].flow_offloading) MUST be OFF:
# a flowtable forwards established TCP flows before ECM classifies them,
# so ECM never sees the flow.
# SQM is OFF by default. If NSS SQM is wanted later, it is nssfq_codel.
# IGMP snooping stays OFF on switch bridges (base default).
