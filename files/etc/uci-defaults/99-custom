#!/bin/sh
# First-boot customizations for jdcloud-ipq6018-nss.
# Runs once on first boot (the uci-defaults mechanism removes this file
# afterwards). No set -e: a failed step must not abort the rest.
#
# Same defaults as the CR880x cr8806 build (user decision 2026-11-05):
# BBR, Argon, DNS hijack, dnsmasq cache/interface/record types.
# LAN IP stays the firmware default (192.168.1.1) and hostname stays
# OpenWrt — this project does NOT do the fork's 192.168.2.1 / LibWrt
# renaming.

# --- TCP BBR as the default congestion control ---
# The kernel-config default does not survive defconfig on some trees,
# so set it here: persist in sysctl.conf for every boot, and apply
# live now (the tcp_bbr module is already loaded via modules.d by
# this point). (This tree's kmod-tcp-bbr also ships a sysctl.d file
# that sets it; this line is belt-and-braces and matches the CR880x
# project's proven behavior.)
grep -q '^net.ipv4.tcp_congestion_control=bbr$' /etc/sysctl.conf 2>/dev/null || \
  echo 'net.ipv4.tcp_congestion_control=bbr' >> /etc/sysctl.conf
sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1

# --- Argon as the default LuCI theme ---
# Both Argon and Bootstrap are installed; Bootstrap is OpenWrt's
# fallback default, so set Argon explicitly (reversible in LuCI).
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci

# --- DNS hijack: redirect all LAN TCP/UDP 53 traffic to the router ---
# This forces clients with hardcoded DNS (e.g. 8.8.8.8) through the
# router's resolver (dnsmasq), so caching applies to them.
lan_ip=$(uci -q get network.lan.ipaddr)
[ -n "$lan_ip" ] || lan_ip='192.168.1.1'
uci add firewall redirect >/dev/null 2>&1
uci set firewall.@redirect[-1].name='DNS Hijack'
uci set firewall.@redirect[-1].src='lan'
uci set firewall.@redirect[-1].dest='lan'
uci set firewall.@redirect[-1].proto='tcp udp'
uci set firewall.@redirect[-1].src_dport='53'
uci set firewall.@redirect[-1].dest_ip="$lan_ip"
uci set firewall.@redirect[-1].dest_port='53'
uci set firewall.@redirect[-1].target='DNAT'
uci commit firewall

# --- dnsmasq cache size + listen interface + cached record types ---
# dnsmasq is the default resolver. Raise its cache from the 150-entry
# default so repeated queries are answered locally; 1000 entries cost
# only tens of KB of RAM.
# Listen explicitly on lan + cache ANY/A/AAAA: the default left
# IPv6/AAAA-dependent CDN queries unanswered (streaming avatars /
# video thumbnails failed — CR880x finding, 2026-11-05).
# interface 'lan' is LAN-IP-agnostic (a literal listen_address list
# would bake in one device's LAN IP / ULA / link-local); it covers
# all br-lan addresses (v4+v6).
# Restart to apply (first boot only).
uci set dhcp.@dnsmasq[0].cachesize='1000'
uci set dhcp.@dnsmasq[0].interface='lan'
uci add_list dhcp.@dnsmasq[0].cache_rr='ANY'
uci add_list dhcp.@dnsmasq[0].cache_rr='A'
uci add_list dhcp.@dnsmasq[0].cache_rr='AAAA'
uci commit dhcp
/etc/init.d/dnsmasq restart >/dev/null 2>&1
/etc/init.d/firewall reload >/dev/null 2>&1

exit 0
