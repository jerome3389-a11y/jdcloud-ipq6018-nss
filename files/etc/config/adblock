# Adblock preset (ipq50xx-openwrt-nss, 2026-11-03).
# Feeds enabled here; the lists themselves download on first boot with
# internet (they go stale, so they are NOT baked into the image).
# Feed names come from the adblock package's adblock.feeds:
# anti_ad = CN list, adguard/yoyo/disconnect = common general lists.
# Large feeds (XL/XXL/VAR) are deliberately left out: list size drives
# dnsmasq RAM on this 256 MB board. Add more later with UCI, e.g.
#   uci add_list adblock.global.adb_feed='stevenblack'
#   uci commit adblock && /etc/init.d/adblock restart
config adblock 'global'
	option adb_enabled '1'
	option adb_debug '0'
	option adb_nftforce '0'
	option adb_dnsshift '0'
	option adb_safesearch '0'
	option adb_mail '0'
	option adb_report '0'
	list adb_feed 'anti_ad'
	list adb_feed 'adguard'
	list adb_feed 'yoyo'
	list adb_feed 'disconnect'
