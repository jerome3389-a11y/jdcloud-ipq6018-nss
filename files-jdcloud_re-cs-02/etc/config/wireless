# Static wireless for JDCloud RE-CS-02 (Athena) — jdcloud-ipq6018-nss.
#
# *** UNVERIFIED — derived from the DTS only, never seen on a running
# *** device (the user has no Athena hardware). If WiFi does not come
# *** up on Athena, this file is the first suspect: delete it from the
# *** image and let the tree's detect script generate the config
# *** (SSID LibWrt, no key) to find the real paths from
# *** /etc/board.json on the running device.
#
# Derivation (from LiBwrt 25.12-nss @ 96a0ec8a):
#   * 2.4G is the SoC radio: same single wifi@c000000 node as Arthur
#     (patch 0906), path platform/soc@0/c000000.wifi, radio '0'.
#     HE40 (2x2 40 MHz) as on Arthur.
#   * 5G is the QCN9074 on PCIe: re-cs-02.dts has
#     &pcie0 { pcie@0 { wifi@0,0 { compatible = "pci17cb,1104";
#     reg = <0x00010000 0 0 0 0>; ... } } } — bus 1, device 0,
#     function 0 behind root port 0000:00:00.0, so the OpenWrt path
#     is pci0000:00/0000:00:00.0/0000:01:00.0. A single-radio phy
#     needs no `option radio`.
#   * 5G is HE160: the QCN9074 is a 4-stream 802.11ax radio that
#     supports 160 MHz (unlike Arthur's integrated 5G, which caps
#     at 80 MHz). UNVERIFIED — if hostapd refuses the 5G radio,
#     drop this to HE80 first.
#   * If the SoC WCSS on Athena exposes a second (5G) radio besides
#     the QCN9074, the detect script will add it as an extra radio
#     with the default SSID (radio_exists() only skips radios already
#     in this file) — harmless, and it tells us the topology.
#   * Roaming / SSIDs / key / country match the CR880x defaults
#     (user decision 2026-11-05).
# This file is per-device (files-jdcloud_re-cs-02/); the workflow's
# per-device overlay applies it after files/, so it never leaks into
# the Arthur image.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option radio '0'
	option band '2g'
	option country 'CN'
	option channel 'auto'
	option htmode 'HE40'
	option cell_density '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt'
	option encryption 'psk2'
	option key '12345678'
	option ieee80211k '1'
	option bss_transition '1'
	option wnm_sleep_mode '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '5g'
	option country 'CN'
	option channel 'auto'
	option htmode 'HE160'
	option cell_density '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt_5G'
	option encryption 'psk2'
	option key '12345678'
	option ieee80211k '1'
	option bss_transition '1'
	option wnm_sleep_mode '1'
