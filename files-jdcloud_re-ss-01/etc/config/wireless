# Static wireless for JDCloud RE-SS-01 (Arthur) — jdcloud-ipq6018-nss.
#
# VERIFIED FROM SOURCE (not from a running device yet — first boot
# verification is still open, see README):
#   * IPQ6018 has ONE wifi DT node, wifi@c000000 (added by the base
#     tree's patch 0906-arm64-dts-qcom-ipq6018-add-wifi-node.patch),
#     NOT two nodes like the CR880x's IPQ5018 (c000000.wifi +
#     b00a040.wifi). Both radios share the path
#     platform/soc@0/c000000.wifi and are distinguished by
#     `option radio '0'` (2.4G) / `option radio '1'` (5G) — this is
#     exactly what the tree's own detect script emits
#     (package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc:
#     `if (length(info.radios) > 0) id += "radio='${radio.index}'"`).
#   * 5G is HE80, NOT the CR880x's HE160: IPQ6018 is AX1800-class
#     (5G 2x2 80 MHz = 1201 Mbps; 2.4G 2x2 40 MHz = 574 Mbps).
#     The tree's detect caps 5G width at 80 for the same reason
#     (mac80211.uc: `else if (width > 80) width = 80`). HE160 would
#     be invalid on this radio. 2.4G HE40 is valid and kept.
#   * Roaming: 802.11k + 802.11v components on, 802.11r/802.11s off —
#     same as the CR880x cr8806 build. 802.11v is set via the raw
#     options bss_transition + wnm_sleep_mode (the tree's ap.uc never
#     reads config.ieee80211v — same generator gap as on the CR880x).
#   * SSIDs / key / country / auto channel match the CR880x defaults
#     (user decision 2026-11-05).
# This file is per-device (files-jdcloud_re-ss-01/); the workflow's
# per-device overlay applies it after files/, so it never leaks into
# the Athena image.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option radio '0'
	option band '2g'
	option country 'CN'
	option channel 'auto'
	option htmode 'HE40'
	option cell_density '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt'
	option encryption 'psk2'
	option key '12345678'
	option ieee80211k '1'
	option bss_transition '1'
	option wnm_sleep_mode '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option radio '1'
	option band '5g'
	option country 'CN'
	option channel 'auto'
	option htmode 'HE80'
	option cell_density '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt_5G'
	option encryption 'psk2'
	option key '12345678'
	option ieee80211k '1'
	option bss_transition '1'
	option wnm_sleep_mode '1'
